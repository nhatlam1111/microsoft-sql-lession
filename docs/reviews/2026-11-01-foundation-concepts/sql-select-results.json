  {
    "id": "key-nullability",
    "query": "SELECT OBJECT_NAME(c.object_id) AS TableName, c.name AS ColumnName, c.is_nullable AS IsNullable FROM sys.columns AS c WHERE (c.object_id=OBJECT_ID('dbo.NhanVien') AND c.name IN ('MaNV','MaPB')) OR (c.object_id=OBJECT_ID('dbo.PhongBan') AND c.name='MaPB') OR (c.object_id=OBJECT_ID('dbo.HopDong') AND c.name='MaNV') ORDER BY TableName,ColumnName;",
    "rows": [
