  {
    "id": "declared-foreign-keys-and-enabled-state",
    "query": "SELECT t.name AS TableName, c.name AS ColumnName,\n    rt.name AS ReferencedTable, rc.name AS ReferencedColumn,\n    fk.name AS ConstraintName, fk.is_disabled AS IsDisabled,\n    fk.is_not_trusted AS IsNotTrusted\nFROM sys.foreign_keys AS fk\nJOIN sys.foreign_key_columns AS fkc ON fkc.constraint_object_id = fk.object_id\nJOIN sys.tables AS t ON t.object_id = fkc.parent_object_id\nJOIN sys.schemas AS s ON s.schema_id = t.schema_id\nJOIN sys.columns AS c ON c.object_id = t.object_id AND c.column_id = fkc.parent_column_id\nJOIN sys.tables AS rt ON rt.object_id = fkc.referenced_object_id\nJOIN sys.columns AS rc ON rc.object_id = rt.object_id AND rc.column_id = fkc.referenced_column_id\nWHERE s.name = 'dbo'\nORDER BY t.name, c.name",
    "rows": [
      {
        "TableName": "BangLuong",
        "ColumnName": "MaNV",
        "ReferencedTable": "NhanVien",
        "ReferencedColumn": "MaNV",
        "ConstraintName": "FK_BangLuong_NhanVien",
        "IsDisabled": false,
        "IsNotTrusted": false
      },
