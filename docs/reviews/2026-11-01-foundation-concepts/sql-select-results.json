        "ReferencedColumn": "MaNV",
        "ConstraintName": "FK_HopDong_NhanVien",
        "IsDisabled": false,
        "IsNotTrusted": false
      },
      {
        "TableName": "NhanVien",
        "ColumnName": "MaCD",
