---
import Result from './Result.astro';
import Sql from './Sql.astro';
import { highlightTsql } from '../../lib/tsql-highlight';
import { checkFlow, inlineCode, nextFlowId, previewOf, rowCount, snakeLayout, splitFocus, type FlowStep } from '../../lib/run-flow';

interface Props {
  /** The whole query the diagram walks through. */
  query: string;
  steps: FlowStep[];
  note?: string;
}
const { query, steps, note = 'Bạn viết SELECT trước, nhưng theo thứ tự logic, SQL Server xét FROM trước.' } = Astro.props;

const problems = checkFlow(steps, query);
if (problems.length) throw new Error(`Sơ đồ thứ tự chạy có lỗi:\n${problems.join('\n')}`);

const drawerId = nextFlowId();
const cells = snakeLayout(steps.length);
const isSqlWord = (code: string) => highlightTsql(code).some(t => t.kind === 'keyword' || t.kind === 'gray' || t.kind === 'function');
const parts = (text: string) => inlineCode(text).map(p => ({ ...p, sqlWord: p.code && isSqlWord(p.text), tokens: highlightTsql(p.text) }));

const views = steps.map((step, i) => {
  const split = splitFocus(query, step.focus)!;
  return {
    step,
    num: String(i + 1).padStart(2, '0'),
    label: `Bước ${String(i + 1).padStart(2, '0')}, ${step.clause}: ${step.title} Còn ${rowCount(step)} dòng.`,
    cell: cells[i],
    preview: previewOf(step),
    count: rowCount(step),
    clause: highlightTsql(step.clause),
    before: highlightTsql(split.before.replace(/\r?\n$/, '')),
    focus: highlightTsql(split.focus),
    after: highlightTsql(split.after.replace(/^\r?\n/, '')),
    meaning: parts(step.meaning),
    detail: parts(step.detail),
  };
});
---
<figure class="rf">
  <p class="rf-note">{note}</p>
  <ol class="rf-grid">
    {views.map((v, i) => (
      <li class="rf-cell" data-arrow={v.cell.arrow ?? undefined} style={`grid-row: ${v.cell.row + 1}; grid-column: ${v.cell.col + 1};`}>
        <button type="button" class="rf-card" aria-label={v.label} data-step={i} aria-expanded="false" aria-controls={drawerId}>
          <span class="rf-top">
            <span class="rf-num">{v.num}</span>
            <span class="rf-clause">{v.clause.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</span>
          </span>
          <span class="rf-title">{v.step.title}</span>
          <span class="rf-count">{i === 0 ? 'có' : 'còn'} {v.count} dòng</span>
          {v.preview.rows.length === 0
            ? <span class="rf-empty">Không còn dòng nào</span>
            : (
              <span class="rf-mini" aria-hidden="true" style={`--cols: ${v.preview.columns.length};`}>
                {v.preview.columns.map(c => <span class="rf-mini-h">{c}</span>)}
                {v.preview.rows.map(r => r.map(c => (c === null ? <span class="res-null">NULL</span> : <span>{c}</span>)))}
              </span>
            )}
          {(v.preview.moreRows > 0 || v.preview.moreCols > 0) && (
            <span class="rf-more">
              {v.preview.moreRows > 0 && <span>+{v.preview.moreRows} dòng</span>}
              {v.preview.moreCols > 0 && <span>+{v.preview.moreCols} cột</span>}
            </span>
          )}
        </button>
      </li>
    ))}
  </ol>

  <aside class="rf-drawer" id={drawerId} hidden tabindex="-1" aria-label="Chi tiết bước">
    <button type="button" class="rf-close" aria-label="Đóng">×</button>
    <div class="rf-d-body">
      {views.map((v, i) => (
        <section class="rf-panel" data-panel={i} hidden>
          <p class="rf-d-head">
            <span class="rf-d-step">Bước {v.num}</span>
            <code class="rf-d-clause">{v.clause.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</code>
          </p>
          <p class="rf-d-title">{v.step.title}</p>
          <pre class="rf-q">{v.before.length > 0 && <span class="rf-q-dim">{v.before.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</span>}<mark class="rf-q-on">{v.focus.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</mark>{v.after.length > 0 && <span class="rf-q-dim">{v.after.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</span>}</pre>
          <p class="rf-d-sub"><code class="rf-kw">{v.clause.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</code> làm gì</p>
          <p class="rf-d-text">{v.meaning.map(p => (!p.code ? p.text : p.sqlWord ? <code class="rf-kw">{p.tokens.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</code> : <code class="rf-id">{p.text}</code>))}</p>
          <p class="rf-d-sub">Ở bước này</p>
          <p class="rf-d-text">{v.detail.map(p => (!p.code ? p.text : p.sqlWord ? <code class="rf-kw">{p.tokens.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</code> : <code class="rf-id">{p.text}</code>))}</p>
          <Result columns={v.step.columns} rows={v.step.rows} total={v.count} />
          <Sql code={v.step.sql} title="Câu lệnh để xem dữ liệu ở bước này" />
          {v.step.excel && (
            <p class="rf-excel"><span class="rf-xmark" aria-hidden="true">X</span><span>Liên hệ Excel: {v.step.excel}</span></p>
          )}
        </section>
      ))}
    </div>
    <div class="rf-d-foot">
      <button type="button" class="rf-nav rf-prev">Bước trước</button>
      <button type="button" class="rf-nav rf-next">Bước sau</button>
    </div>
  </aside>
</figure>

<script>
  import { arrowMove } from '../../lib/run-flow';

  const flows = () => [...document.querySelectorAll<HTMLElement>('.rf')];
  const drawerOf = (root: HTMLElement) => root.querySelector<HTMLElement>('.rf-drawer')!;
  const cardsOf = (root: HTMLElement) => [...root.querySelectorAll<HTMLElement>('.rf-card')];
  const currentOf = (root: HTMLElement) => Number(root.dataset.current ?? 0);

  function show(root: HTMLElement, i: number, takeFocus: boolean) {
    for (const other of flows()) if (other !== root) hide(other, false);
    const drawer = drawerOf(root);
    const panels = [...drawer.querySelectorAll<HTMLElement>('.rf-panel')];
    panels.forEach((panel, k) => { panel.hidden = k !== i; });
    cardsOf(root).forEach((card, k) => card.setAttribute('aria-expanded', String(k === i)));
    root.dataset.current = String(i);
    drawer.querySelector<HTMLButtonElement>('.rf-prev')!.disabled = i === 0;
    drawer.querySelector<HTMLButtonElement>('.rf-next')!.disabled = i === panels.length - 1;
    drawer.hidden = false;
    drawer.querySelector<HTMLElement>('.rf-d-body')!.scrollTop = 0;
    if (takeFocus) drawer.focus({ preventScroll: true });
  }

  function hide(root: HTMLElement, returnFocus: boolean) {
    const drawer = drawerOf(root);
    if (drawer.hidden) return;
    drawer.hidden = true;
    const cards = cardsOf(root);
    cards.forEach(card => card.setAttribute('aria-expanded', 'false'));
    if (returnFocus) cards[currentOf(root)]?.focus({ preventScroll: true });
  }

  function move(root: HTMLElement, by: number) {
    const next = currentOf(root) + by;
    if (next < 0 || next >= cardsOf(root).length) return;
    show(root, next, false);
    // Stepping onto the first or last step disables the button that had focus; keep focus in the drawer.
    const active = document.activeElement as HTMLButtonElement | null;
    if (!active || active === document.body || active.disabled) drawerOf(root).focus({ preventScroll: true });
  }

  document.addEventListener('click', event => {
    const target = event.target as HTMLElement | null;
    const card = target?.closest<HTMLElement>('.rf-card');
    if (card) { show(card.closest<HTMLElement>('.rf')!, Number(card.dataset.step), true); return; }
    const root = target?.closest<HTMLElement>('.rf');
    if (!root || !target) return;
    if (target.closest('.rf-close')) hide(root, true);
    else if (target.closest('.rf-prev')) move(root, -1);
    else if (target.closest('.rf-next')) move(root, 1);
  });

  // Capture phase: React closes the roadmap popup or the search box before a bubbling listener
  // would run, and the drawer must not take that same Esc as its own.
  document.addEventListener('keydown', event => {
    const root = flows().find(r => !drawerOf(r).hidden);
    if (!root || document.querySelector('.rp-backdrop, .sd-backdrop')) return;
    if (event.key === 'Escape') { hide(root, true); return; }
    const target = event.target as HTMLElement;
    const drawer = drawerOf(root);
    const onDrawerOrCard = !!target.closest?.('.rf-card') || (drawer.contains(target) && !target.closest('.res-scroll, pre'));
    const by = arrowMove(event, onDrawerOrCard);
    if (by !== 0) {
      event.preventDefault();
      move(root, by);
    }
  }, true);

  document.addEventListener('mousedown', event => {
    const target = event.target as HTMLElement;
    for (const root of flows()) {
      const drawer = drawerOf(root);
      if (!drawer.hidden && !drawer.contains(target) && !target.closest('.rf-card')) hide(root, false);
    }
  });
</script>
