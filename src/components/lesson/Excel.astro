---
interface Props {
  rows: (string | number)[][];
  cell?: string;
  formula?: string;
  sheets?: string;
  selected?: string;
  /** Cells such as "C4" that the lesson points at, besides the selected one. */
  mark?: string[];
}
const { rows, cell, formula, sheets, selected, mark = [] } = Astro.props;
const ERROR_VALUE = /^#(N\/A|VALUE!|REF!|DIV\/0!|NAME\?|NUM!|NULL!)$/;
const width = Math.max(...rows.map(r => r.length));
const letters = Array.from({ length: width }, (_, i) => String.fromCharCode(65 + i));
const refs = new Set(rows.flatMap((_, ri) => letters.map(l => `${l}${ri + 1}`)));
for (const m of mark) if (!refs.has(m)) throw new Error(`Excel: không có ô ${m} để đánh dấu`);
const cellClass = (value: string | number, ref: string) =>
  [ERROR_VALUE.test(String(value)) && 'xl-err', ref === selected && 'xl-sel', mark.includes(ref) && 'xl-mark', typeof value === 'number' && 'xl-num']
    .filter(Boolean).join(' ') || undefined;
---
<figure class="xl">
  <div class="xl-head"><span class="xl-app">Excel</span>{sheets && <span class="xl-sheets">{sheets}</span>}</div>
  {(cell || formula) && (
    <div class="xl-fx"><span class="xl-name">{cell}</span><span class="xl-fx-label">fx</span><span class="xl-formula">{formula}</span></div>
  )}
  <div class="xl-scroll">
    <table class="xl-grid">
      <thead><tr><th class="xl-corner"></th>{letters.map(l => <th>{l}</th>)}</tr></thead>
      <tbody>
        {rows.map((r, ri) => (
          <tr class={ri === 0 ? 'xl-first' : undefined}>
            <th class="xl-rn">{ri + 1}</th>
            {letters.map((l, ci) => <td class={cellClass(r[ci] ?? '', `${l}${ri + 1}`)}>{r[ci] ?? ''}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
