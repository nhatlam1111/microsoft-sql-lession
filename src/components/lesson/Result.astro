---
import { COURSE_SERVER } from '../../lib/course-server';

interface Props {
  columns: string[];
  rows: (string | number | null)[][];
  db?: string;
  total?: number;
  /** Row numbers (from 1, as in the grid) that the lesson points at. */
  mark?: number[];
}
const { columns, rows, db = COURSE_SERVER.database, total, mark = [] } = Astro.props;
for (const m of mark) if (!Number.isInteger(m) || m < 1 || m > rows.length) throw new Error(`Result: không có dòng ${m} để đánh dấu`);
const count = `${total ?? rows.length} rows`;
const trimmed = total !== undefined && total > rows.length ? `Trích ${rows.length} dòng (kết quả có ${total} dòng)` : null;
---
<figure class="res">
  <div class="res-tabs"><span class="res-tab is-active">Results</span><span class="res-tab">Messages</span></div>
  <div class="res-scroll">
    <table class="res-grid">
      <thead><tr><th class="res-rn"></th>{columns.map(c => <th>{c}</th>)}</tr></thead>
      <tbody>
        {rows.map((r, i) => (
          <tr class={mark.includes(i + 1) ? 'res-mark' : undefined}>
            <td class="res-rn">{i + 1}</td>
            {r.map(v => (v === null ? <td class="res-null">NULL</td> : <td>{v}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="res-status"><span class="res-ok">✓ Query executed successfully.</span><span>{db}</span><span>{count}</span></div>
  {trimmed && <figcaption class="res-trim">{trimmed}</figcaption>}
</figure>
