---
import { DbDiagram } from '../islands/DbDiagram';
import { parseSchema } from '../../lib/db-schema';
import schemaSql from '../../../database/HRM_Demo.sql?raw';
import { DIAGRAM_LEGEND } from '../../lib/db-diagram';

interface Props {
  caption?: string;
  /** Tables the lesson walks through, in order; they and the links between them are lit up. */
  path?: string[];
}
const { caption, path } = Astro.props;
const tables = parseSchema(schemaSql);
---
<figure class="erd">
  <div class="erd-scroll" tabindex="0" role="group" aria-label="Sơ đồ quan hệ của HRM_Demo, cuộn ngang để xem hết">
    <DbDiagram tables={tables} path={path} />
  </div>
  <figcaption>{caption ?? DIAGRAM_LEGEND}</figcaption>
</figure>
