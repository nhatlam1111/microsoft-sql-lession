---
import { highlightTsql } from '../../lib/tsql-highlight';

interface Props {
  code: string;
  title?: string;
}
const { title = 'SQL Server' } = Astro.props;
const code = Astro.props.code.replace(/^(?:[ \t]*\r?\n)+/, '').replace(/(?:\r?\n[ \t]*)+$/, '');
const tokens = highlightTsql(code);
---
<figure class="sql">
  <div class="sql-head">
    <span class="sql-title">{title}</span>
    <button type="button" class="sql-copy" data-copy={code}>Sao chép</button>
  </div>
  <pre class="sql-code"><code>{tokens.map(t => (t.kind === 'plain' ? t.text : <span class={`t-${t.kind}`}>{t.text}</span>))}</code></pre>
</figure>

<script>
  document.addEventListener('click', event => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('.sql-copy');
    if (!button) return;
    const show = (text: string) => {
      button.textContent = text;
      setTimeout(() => { button.textContent = 'Sao chép'; }, 1500);
    };
    // The clipboard can be refused (no permission, page not focused); say so instead of doing nothing.
    Promise.resolve()
      .then(() => navigator.clipboard.writeText(button.dataset.copy ?? ''))
      .then(() => show('Đã chép'), () => show('Không chép được'));
  });
</script>
