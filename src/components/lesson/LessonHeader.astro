---
import type { CatalogEntry } from '../../lib/catalog';
import type { LevelDef } from '../../data/curriculum';
import { lessonUrl } from '../../lib/paths';

interface Props {
  entry: CatalogEntry;
  level: LevelDef;
  prerequisites: CatalogEntry[];
}
const { entry, level, prerequisites } = Astro.props;
const levelLabel = `Level ${level.no} · ${level.name}`;
const lessonLabel = `Bài ${entry.num}`;
const minutes = `Khoảng ${entry.minutes} phút`;
---
<header class="lesson-head" style={`--lv: var(--lv${level.no}); --lv-soft: var(--lv${level.no}-soft);`}>
  <p class="lesson-crumbs">
    <span class="level-tag">{levelLabel}</span>
    <span class="lesson-no">{lessonLabel}</span>
    {entry.kind === 'summary' && <span class="chip-summary">Bản tóm tắt</span>}
  </p>
  <h1 class="lesson-title">{entry.title}</h1>
  {(entry.kind === 'full' || prerequisites.length > 0) && (
    <p class="lesson-meta">
      {entry.kind === 'full' && <span>{minutes}</span>}
      {prerequisites.length > 0 && (
        <span>Cần biết trước: {prerequisites.map((p, i) => (
          <>{i > 0 && ', '}<a href={lessonUrl(p.slug)}>{p.num} {p.shortTitle}</a></>
        ))}</span>
      )}
    </p>
  )}
  <p class="lesson-goal"><strong>Học xong bài này:</strong> {entry.goal}</p>
</header>
