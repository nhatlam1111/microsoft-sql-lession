---
import type { CatalogEntry } from '../../lib/catalog';
import { isCurrentPage, withBase } from '../../lib/paths';
import TopProgress from '../islands/TopProgress';
import ProgressMenu from '../islands/ProgressMenu';

interface Props {
  catalog: CatalogEntry[];
}
const { catalog } = Astro.props;
const nums = catalog.map(e => e.num);
const current = (path: string) => (isCurrentPage(Astro.url.pathname, path) ? 'page' : undefined);
---
<header class="topbar">
  <a class="brand" href={withBase('/')}>
    <svg class="brand-mark" viewBox="0 0 20 20" aria-hidden="true">
      <rect x="1" y="1" width="18" height="18" rx="4" fill="currentColor" />
      <path d="M1 7h18M1 13h18M7 7v12" stroke="#fff" stroke-width="1.6" />
    </svg>
    <span>SQL Server</span>
  </a>
  <button type="button" class="top-search" data-action="search">
    <span>Tìm bài, từ khóa…</span><kbd>Ctrl K</kbd>
  </button>
  <nav class="top-nav" aria-label="Điều hướng chính">
    <button type="button" class="top-btn top-btn-roadmap" data-action="roadmap">Lộ trình</button>
    <a class="top-btn" href={withBase('/')} aria-current={current('/')}>Mindmap</a>
    <a class="top-btn" href={withBase('/gioi-thieu/')} aria-current={current('/gioi-thieu/')}>Giới thiệu</a>
  </nav>
  <TopProgress client:load nums={nums} />
  <ProgressMenu client:load nums={nums} />
  <slot />
</header>

<script>
  import { EVENTS, emit } from '../../lib/events';
  document.querySelector('[data-action="roadmap"]')?.addEventListener('click', () => emit(EVENTS.openRoadmap));
  document.querySelector('[data-action="search"]')?.addEventListener('click', () => emit(EVENTS.openSearch));
</script>
