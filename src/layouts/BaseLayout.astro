---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource/literata/400.css';
import '@fontsource/literata/400-italic.css';
import '@fontsource/literata/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/lesson.css';
import '../styles/islands.css';
import TopBar from '../components/layout/TopBar.astro';
import NarrowNotice from '../components/layout/NarrowNotice.astro';
import RoadmapPopup from '../components/islands/RoadmapPopup';
import SearchDialog from '../components/islands/SearchDialog';
import { AREAS, LEVELS } from '../data/curriculum';
import { loadCatalog } from '../lib/load-catalog';

interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const catalog = await loadCatalog();
const pageTitle = title === 'SQL Server' ? title : `${title} · SQL Server`;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body class={wide ? 'is-wide' : undefined}>
    <TopBar catalog={catalog} />
    <NarrowNotice />
    <slot />
    <RoadmapPopup client:only="react" catalog={catalog} levels={LEVELS} />
    <SearchDialog client:only="react" catalog={catalog} areas={AREAS} levels={LEVELS} />
  </body>
</html>
